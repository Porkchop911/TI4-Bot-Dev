# /etc/ti4-public/env  (chmod 640, owner root:ti4)  -- copy from deploy/public/env.example
# Read by ti4-public.service via EnvironmentFile=.

# Public mode: dev routes off, no ML bots, per-IP rate limits, caps. Keep it at 1.
TI4_PUBLIC=1

# Loopback only; Caddy is the only thing reachable from outside.
HOST=127.0.0.1
PORT=18200

# Built client (the deploy script keeps this path pointing at the current release).
TI4_WEB_DIR=/opt/ti4-public/current/dist

# Games, player sessions and feedback live here (feedback under feedback/YYYY-MM-DD/).
TI4_DATA_DIR=/var/lib/ti4-public

# The one shared password for the whole playtest. Change it to cut everybody off.
TI4_ACCESS_PASSWORD=change-me-to-something-you-can-text-your-friends

# Optional: fixed cookie-signing secret (otherwise a random one per start, which logs everybody
# out on every restart). Generate with: openssl rand -hex 32
TI4_COOKIE_SECRET=

# The public https origin. Marks the cookie Secure and pins CORS to this origin.
TI4_PUBLIC_ORIGIN=https://play.example.org

# Caddy runs on 127.0.0.1 and sets X-Forwarded-For: use it for per-IP limits.
TI4_TRUST_PROXY=1

# Caps (defaults shown).
TI4_MAX_GAMES=200
TI4_MAX_LOBBIES_PER_IP=12

# Per-IP request rate limits (game create, lobby join, websocket connect, batches, feedback, ...).
# off = lifted for everything except password attempts. Remove the line (or set on) to enable.
TI4_RATE_LIMITS=off
TI4_MAX_DATA_BYTES=2147483648
TI4_WS_IDLE_SECS=300

# Shown in /health and attached to feedback. deploy.sh bakes the git commit into the binary at
# build time; set this only to override it.
#TI4_BUILD_COMMIT=

# Never set on the public server (ML bots stay off in TI4_PUBLIC mode anyway):
# TI4_BOT_PASSWORD, TI4_ADVISOR_URL, TI4_BOT_AGENT_BIN

RUST_LOG=info
