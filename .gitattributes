# The content corpus is copied byte-for-byte from the Python oracle and its SHA-256
# checksums are recorded in crates/ti4-content/content/CHECKSUMS.sha256. End-of-line
# conversion would invalidate those checksums on a non-Windows checkout, so these files
# are never translated.
crates/ti4-content/content/*.json -text
crates/ti4-content/content/CHECKSUMS.sha256 -text

# Rust sources are normalised to LF in the repository.
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf

# The bounded legacy trace corpus is checksummed and byte-counted in its own manifest, for the
# same reason and with the same consequence: end-of-line conversion adds one byte per line on a
# Windows checkout and every size and digest stops matching. This is not hypothetical — the
# corpus passed in the worktree that generated it, where the files were never re-checked-out,
# and failed on the first fresh checkout of the same commit.
fixtures/legacy_entropy/**/*.ndjson -text
fixtures/legacy_entropy/**/*.json -text
