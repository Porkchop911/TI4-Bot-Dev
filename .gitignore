*.py[cod]
*.pyo
*.pyd
.env
.venv

# Local state
.pi-control/
/out/
# A second target directory for the CUDA-linked build, so the CPU gate keeps working while
# M10-037 iterates. Same reason /target/ is ignored: it is build output, not source.
/target-cuda/
/target-publisher/
*.log
/.tmp-m00-*/
/.tmp-m00-011/
data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build products
*.snap
*.profraw
*.profdata

# The bounded oracle traces and sealed MLP baselines are the retained, checksummed fixture corpora.
!fixtures/
fixtures/*
!fixtures/mlp-baselines/
fixtures/mlp-baselines/*
!fixtures/mlp-baselines/**
!fixtures/legacy_entropy/
fixtures/legacy_entropy/*
!fixtures/legacy_entropy/bounded-v1/
!fixtures/legacy_entropy/bounded-v1/**
# The catalogue of the engine for the tests of web, written by `cargo wire-web`.
!fixtures/catalog/
!fixtures/catalog/**
# The nicknames that the server and the pages take or refuse (`web-shared/src/identity/nickname.ts`).
!fixtures/nickname/
!fixtures/nickname/**
# The logits of the synthetic MLP models, which the wasm build must give bit for bit (`cargo wire-web`).
!fixtures/infer/
!fixtures/infer/**
# The models of the servers of web2's tests: the synthetic test model under three names (`cargo wire-web`).
!fixtures/models/
!fixtures/models/**

# Local git worktrees. Gitlinks to them are meaningless to a clone.
.worktrees/

# Local git bundles taken before handing the repo to another agent.
.backup/

# Bug-fix worktree build output. Named to avoid colliding with the shared tree's
# target dirs; the ignore list matches by name, so it needs saying explicitly.
/target-bugfix/

# Audit worktree build and artifact directories.
/target-audit/
/target-cuda-audit/
/checkpoints/
/dryrun-control/
/dryrun-cuda-gate/

# Merge/eval worktree build output.
/target-merge/
/target-cuda/

# ti4calc reference clone for arena validation, never committed
/tools/ti4calc/

# Nightly UI smoke sweep output (tools/nightly-smoke)
/nightly-reports/
/nightly-reports-test/
node_modules/
web/.e2e-dist/
